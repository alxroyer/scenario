  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alxroyer/scenario/blob/master/schemas/req-db_v0.3.0.schema.json",
  "title": "Scenario requirement database v0.3.0",
  "description": "Schema that describes a database of requirements for the `scenario` library",
  "$ref": "#/$defs/main",
  "$defs": {
    "main": {
      "description": "Scenario requirement database",
      "type": "object",
      "properties": {
        "$encoding": {
          "description": "Encoding of the file",
          "$ref": "#/$defs/_non-empty-string"
        },
        "$license": {
          "description": "Ability to provide a license text for a JSON file",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "$schema": {
          "description": "Schema reference",
          "$ref": "#/$defs/_non-empty-string"
        },
        "$version": {
          "description": "`scenario` version used to generate the file",
          "$ref": "#/$defs/_non-empty-string"
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/req"
      }
    },
    "req": {
      "description": "Requirement",
      "type": "object",
      "properties": {
        "id": {
          "description": "Requirement identifier",
          "type": "string"
        },
        "title": {
          "description": "Requirement title",
          "type": "string"
        },
        "text": {
          "description": "Requirement text",
          "type": "string"
        },
        "subrefs": {
          "description": "Requirement subreferences",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id"
      ]
    },
    "_non-empty-string": {
      "description": "Non empty string type",
      "type": "string",
      "minLength": 1
    }
  }
}