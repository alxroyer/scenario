  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alxroyer/scenario/blob/master/schemas/common_v0.1.0.schema.json",
  "title": "Common definitions for scenario schemas v0.1.0",
  "description": "Schema that contains common definitions for schemas provided by the `scenario` library.",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "_heading-properties": {
      "description": "Heading properties.",
      "type": "object",
      "properties": {
        "$schema": {
          "description": "Schema reference.",
          "$ref": "#/$defs/non-empty-string"
        }
      },
      "additionalProperties": true
    },
    "iso8601": {
      "description": "ISO8601 date/time format.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(((\\+|-)[0-9]{2}:[0-9]{2})|(Z([0-9]{4})?))?$"
    },
    "location": {
      "description": "Location.",
      "type": "string"
    },
    "execution-status": {
      "description": "Execution status.",
      "anyOf": [
        {
          "const": "SUCCESS"
        },
        {
          "const": "WARNINGS"
        },
        {
          "const": "FAIL"
        }
      ]
    },
    "array-of-errors": {
      "description": "Array of errors.",
      "type": "array",
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/error"
          },
          {
            "$ref": "#/$defs/known-issue"
          }
        ]
      }
    },
    "array-of-warnings": {
      "description": "Array of warnings.",
      "type": "array",
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/known-issue"
          }
        ]
      }
    },
    "error": {
      "description": "Error.",
      "type": "object",
      "properties": {
        "type": {
          "description": "Error type.",
          "type": "string"
        },
        "location": {
          "description": "Error location.",
          "$ref": "#/$defs/location"
        },
        "message": {
          "description": "Error message.",
          "type": "string"
        }
      },
      "required": [
        "message"
      ]
    },
    "known-issue": {
      "description": "Known issue.",
      "type": "object",
      "properties": {
        "type": {
          "description": "Error type.",
          "const": "known-issue"
        },
        "location": {
          "description": "Error location.",
          "$ref": "#/$defs/location"
        },
        "id": {
          "description": "Issue identifier.",
          "$ref": "#/$defs/non-empty-string"
        },
        "message": {
          "description": "Error message.",
          "type": "string"
        }
      },
      "required": [
        "type",
        "location",
        "id",
        "message"
      ]
    },
    "non-empty-string": {
      "description": "Non empty string type.",
      "type": "string",
      "minLength": 1
    }
  }
}